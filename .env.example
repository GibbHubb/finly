# ── Backend ──────────────────────────────────────────────────────────────────
# SQLite (default dev). For PostgreSQL use: postgresql://user:pass@db:5432/finly
DATABASE_URL=sqlite:///./finly.db

# Generate a strong random value for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-in-production

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── F33: deployment ──────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API. Must include the deployed
# frontend URL or every browser request fails CORS.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Public demo account. DEMO_MODE gates the passwordless /auth/demo-login
# endpoint AND the scheduled reset that deletes the demo user's rows.
# Leave OFF (0) on any deployment holding real data.
DEMO_MODE=0
DEMO_USER_EMAIL=demo@finly.app
DEMO_USER_PASSWORD=demo-only-not-a-secret
DEMO_USER_NAME=Demo User
DEMO_RESET_MINUTES=60

# ── Frontend ──────────────────────────────────────────────────────────────────
# Origin of the API. Empty = use the relative path (what the Vite dev proxy
# expects). Set to the deployed backend URL in production — no trailing slash
# and no /api/v1 suffix; api.ts appends that itself.
VITE_API_URL=
