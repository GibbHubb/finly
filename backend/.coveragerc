[run]
# F47 — the coverage floors live in pytest.ini (--cov-fail-under, blended total) and in
# .github/workflows/ci.yml (scripts/coverage_floor.py: lines and branches separately).
# coverage.py has no branch-only threshold, which is why the second gate exists.
branch = True
source = app
omit =
    app/main.py
    app/core/config.py
    */__init__.py

[report]
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if TYPE_CHECKING:
    if __name__ == .__main__.:
skip_covered = False
show_missing = True
