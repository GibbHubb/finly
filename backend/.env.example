DATABASE_URL=sqlite:///./finly.db
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# F27 — GoCardless Bank Account Data (sandbox).
# Get free sandbox keys at https://gocardless.com/bank-account-data/
# (the /bank/* endpoints 503 until both are set).
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
GOCARDLESS_BASE_URL=https://bankaccountdata.gocardless.com/api/v2
GOCARDLESS_REDIRECT_URL=http://localhost:5173/bank/callback
GOCARDLESS_SANDBOX_INSTITUTION=SANDBOXFINANCE_SFIN0000
SYNC_INTERVAL_HOURS=24
